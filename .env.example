# Copy to `.env.local` (local) or set in Vercel → Environment Variables (production).
# Never commit `.env.local` or real secrets.

# -----------------------------------------------------------------------------
# Pagamento — Mercado Pago (Pix + webhooks)
# -----------------------------------------------------------------------------
# Access token from Developers → Suas integrações → sua aplicação → Credenciais de produção.
MERCADOPAGO_ACCESS_TOKEN=

# Assinatura secreta em Webhooks / Notificações (valida POST /api/webhooks/mercadopago).
MERCADOPAGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Frete (Correios via Melhor Envio) — define o valor de frete no TOTAL do Pix/cartão
# O MP não calcula frete: o servidor soma produtos + cotação ME antes de criar o pagamento.
# -----------------------------------------------------------------------------
# Token Bearer da integração / API no painel Melhor Envio.
MELHOR_ENVIO_TOKEN=

# CEP de origem (só dígitos ou formatado) — de onde os envios saem.
MELHOR_ENVIO_ORIGIN_CEP=

# Peso do pacote em kg para cotação (ex.: 0.3).
CORREIOS_PACKAGE_WEIGHT_KG=0.3

# Valor declarado (R$) para seguro na cotação ME — opcional (padrão 100 no código).
# MELHOR_ENVIO_INSURANCE_VALUE_BRL=

# -----------------------------------------------------------------------------
# Stripe (cartão)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

STRIPE_WEBHOOK_SECRET=

# Optional: same value as header `x-gfj-webhook-secret` in Stripe → Webhook → Additional headers.
STRIPE_WEBHOOK_EXTRA_SECRET=

# Optional: Stripe signature timestamp tolerance in seconds (default 300, clamped 60–600).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=

# -----------------------------------------------------------------------------
# E-mail (Resend)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
