# Stripe — copy to `.env.local` and fill with your Dashboard keys (test vs live).
# Never commit `.env.local` or real secrets.

# Secret key (server only). Test: sk_test_... — Live: sk_live_...
STRIPE_SECRET_KEY=

# Publishable key (for future frontend Elements / Checkout). Test: pk_test_... — Live: pk_live_...
# Not used by the API routes yet; set when you wire the UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from Developers → Webhooks → your endpoint → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
